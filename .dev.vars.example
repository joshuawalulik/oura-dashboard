# Copy to .dev.vars for local development (`wrangler dev`). Never commit .dev.vars.
OURA_CLIENT_ID = "your-oura-client-id"
OURA_CLIENT_SECRET = "your-oura-client-secret"
CF_ACCESS_AUD = "your-access-application-aud-tag"
CF_ACCESS_TEAM_DOMAIN = "yourteam.cloudflareaccess.com"
OWNER_EMAIL = "owner@example.com"

# DEV ONLY: skips Cloudflare Access JWT validation and treats you as the owner.
# There is no Access in front of `wrangler dev`, so this is required locally.
# NEVER set this in production.
ACCESS_DEV_BYPASS = "1"
